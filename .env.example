# Database connection string (from Supabase: Project Settings > Database > Connection string)
DATABASE_URL=postgres://user:password@host:5432/postgres

# Chat channels (leave empty until you connect Meta)

# Product photos and videos. On Vercel this is filled in automatically when you
# connect a Blob store. For local development set MEDIA_LOCAL_DIR=.uploads instead.
BLOB_READ_WRITE_TOKEN=
MEDIA_LOCAL_DIR=
